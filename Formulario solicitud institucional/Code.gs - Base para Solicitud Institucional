var CONFIG = {
  EMPRESA:     "Óptica Visión de Águila",
  TITULO:      "Solicitud Institucional",
  HORA_INICIO: "08:00 AM",
  HORA_FIN:    "05:30 PM"
};

/** ID fijo de la plantilla Google Doc — NO modificar */
var TEMPLATE_ID = "1yrTXtmPVF_Pry7_SJFRmOgBHUeKkpG_fl8h5Qrsexqc";

// ═══════════════════════════════════════════════════════════
// MODO 1 — Modal dentro del Google Doc (uso original)
// ═══════════════════════════════════════════════════════════

function onOpen() {
  DocumentApp.getUi()
    .createMenu(CONFIG.EMPRESA)
    .addItem("Generar Solicitud", "mostrarFormulario")
    .addToUi();
}

function mostrarFormulario() {
  var html = HtmlService.createHtmlOutputFromFile("Formulario")
    .setWidth(520)
    .setHeight(700);
  DocumentApp.getUi().showModalDialog(html, CONFIG.TITULO);
}

/** Retorna la fecha y horas por defecto al abrir el formulario modal */
function obtenerConfiguracion() {
  return {
    fechaInforme: Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "dd/MM/yyyy"),
    horaInicio:   CONFIG.HORA_INICIO,
    horaFin:      CONFIG.HORA_FIN
  };
}

// ═══════════════════════════════════════════════════════════
// MODO 2 — Web App para el Portal de Nómina (HTTP)
// ═══════════════════════════════════════════════════════════

/**
 * Punto de entrada HTTP GET — método principal desde el Portal de Nómina.
 *
 * Modo generación (desde el portal):
 *   fetch(URL + '?fechaInforme=...&institucion=...&municipio=...')
 *   → Se detecta por la presencia de e.parameter.institucion
 *   → Genera el documento y retorna { ok, id, url }
 *
 * Modo health check (sin parámetros):
 *   → Retorna { ok, status, servicio }
 *
 * Nota: GAS redirige los POST externos a una URL echo que puede fallar.
 * Usar GET con query string es el método más confiable para llamadas externas.
 */
function doGet(e) {
  var param = (e && e.parameter) ? e.parameter : {};

  // Modo: exportar PDF de un documento ya generado
  if (param.accion === 'exportarPDF' && param.id) {
    try {
      var pdf = exportarPDF(param.id);
      return ContentService
        .createTextOutput(JSON.stringify(pdf))
        .setMimeType(ContentService.MimeType.JSON);
    } catch (err) {
      return ContentService
        .createTextOutput(JSON.stringify({ ok: false, mensaje: err.toString() }))
        .setMimeType(ContentService.MimeType.JSON);
    }
  }

  // Modo: generar documento con parámetros del formulario
  if (param.institucion) {
    try {
      var resultado = _generarDocumento(param);
      return ContentService
        .createTextOutput(JSON.stringify(resultado))
        .setMimeType(ContentService.MimeType.JSON);
    } catch (err) {
      return ContentService
        .createTextOutput(JSON.stringify({ ok: false, mensaje: err.toString() }))
        .setMimeType(ContentService.MimeType.JSON);
    }
  }

  // Sin parámetros → health check
  return ContentService
    .createTextOutput(JSON.stringify({
      ok:       true,
      status:   'activo',
      servicio: CONFIG.TITULO,
      empresa:  CONFIG.EMPRESA
    }))
    .setMimeType(ContentService.MimeType.JSON);
}

/**
 * Punto de entrada HTTP POST (compatibilidad — usar doGet para llamadas externas).
 */
function doPost(e) {
  try {
    var datos = JSON.parse(e.postData.contents);
    var resultado = _generarDocumento(datos);
    return ContentService
      .createTextOutput(JSON.stringify(resultado))
      .setMimeType(ContentService.MimeType.JSON);
  } catch (err) {
    return ContentService
      .createTextOutput(JSON.stringify({ ok: false, mensaje: err.toString() }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

// ═══════════════════════════════════════════════════════════
// LÓGICA COMPARTIDA — usada por modal y por Web App
// ═══════════════════════════════════════════════════════════

/**
 * Copia la plantilla y reemplaza todos los marcadores {{...}}.
 *
 * Marcadores esperados en el documento:
 *   {{FECHA_INFORME}}      → datos.fechaInforme
 *   {{NOMBRE_INSTITUCION}} → datos.institucion
 *   {{NOMBRE_MUNICIPIO}}   → datos.municipio
 *   {{LUGAR_JORNADA}}      → datos.lugar
 *   {{FECHAS_DIFUSION}}    → datos.difusion
 *   {{FECHA_JORNADA}}      → datos.fechaJornada
 *   {{HORA_INICIO}}        → datos.horaInicio
 *   {{HORA_FIN}}           → datos.horaFin
 */
function _generarDocumento(datos) {
  var archivo = DriveApp.getFileById(TEMPLATE_ID);
  var copia   = archivo.makeCopy("Solicitud Institucional - " + (datos.institucion || "Sin nombre"));
  var doc     = DocumentApp.openById(copia.getId());
  var body    = doc.getBody();

  body.replaceText("{{FECHA_INFORME}}",      datos.fechaInforme  || _hoy());
  body.replaceText("{{NOMBRE_INSTITUCION}}", datos.institucion   || "");
  body.replaceText("{{NOMBRE_MUNICIPIO}}",   datos.municipio     || "");
  body.replaceText("{{LUGAR_JORNADA}}",      datos.lugar         || "");
  body.replaceText("{{FECHAS_DIFUSION}}",    datos.difusion      || "");
  body.replaceText("{{FECHA_JORNADA}}",      datos.fechaJornada  || "");
  body.replaceText("{{HORA_INICIO}}",        datos.horaInicio    || CONFIG.HORA_INICIO);
  body.replaceText("{{HORA_FIN}}",           datos.horaFin       || CONFIG.HORA_FIN);

  doc.saveAndClose();

  return {
    ok:  true,
    id:  copia.getId(),
    url: "https://docs.google.com/document/d/" + copia.getId() + "/edit"
  };
}

/** Alias público para compatibilidad con el formulario modal */
function generarDocumento(datos) {
  return _generarDocumento(datos);
}

/** Exporta el documento a PDF y elimina la copia intermedia */
function exportarPDF(idDocumento) {
  var archivo = DriveApp.getFileById(idDocumento);
  var pdfBlob = archivo.getBlob().getAs(MimeType.PDF);
  var pdf     = DriveApp.createFile(pdfBlob);
  pdf.setName(archivo.getName() + ".pdf");
  archivo.setTrashed(true);
  return { ok: true, url: pdf.getUrl() };
}

/** Retorna la fecha de hoy en formato dd/MM/yyyy */
function _hoy() {
  return Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "dd/MM/yyyy");
}
